# ─────────────────────────────────────────────────────────────
# Skylark Surveillance — root environment (read by docker compose)
# Copy to `.env` and adjust as needed. Sane dev defaults are provided.
# ─────────────────────────────────────────────────────────────

# --- Postgres ---
POSTGRES_USER=skylark
POSTGRES_PASSWORD=skylark
POSTGRES_DB=skylark

# --- Shared secrets ---
JWT_SECRET=change-me-in-prod-please-32+chars-long
JWT_EXPIRES_IN=7d
WORKER_API_KEY=worker-shared-secret-change-me

# --- Backend ---
BACKEND_PORT=8080
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Worker ---
WORKER_HTTP_PORT=8090
WEBRTC_UDP_PORT=8091
# IP the BROWSER uses to reach the worker's WebRTC media. For local docker use
# 127.0.0.1. For a remote deployment set this to the host's public IP.
WEBRTC_PUBLIC_IP=127.0.0.1
DETECTION_CONFIDENCE=0.5
DETECTION_INTERVAL_MS=200
ALERT_DEDUP_WINDOW_MS=5000
STATS_INTERVAL_MS=2000

# --- Frontend ---
FRONTEND_PORT=5173

# --- Test RTSP source (the bundled demo stream of walking pedestrians) ---
# Seeded demo camera points at rtsp://mediamtx:8554/stream
MEDIAMTX_RTSP_PORT=8554
